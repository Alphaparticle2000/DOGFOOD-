# ==============================================================================
# DOGFOOD Hackathon Platform - Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit the actual .env file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration
# Retrieve from Supabase Dashboard:
#   - Click 'Connect' in the top bar OR go to Settings (gear) -> API Keys
# Note: Supabase supports new API keys (sb_publishable_... / sb_secret_...)
# as well as legacy JWT keys (eyJ...). Both formats are accepted.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Public/Client Key: Use new Publishable Key (sb_publishable_...) or legacy anon key (eyJ...)
SUPABASE_ANON_KEY=sb_publishable_...

# Secret/Server Key: Use new Secret Key (sb_secret_...) or legacy service_role key (eyJ...)
# CAUTION: Bypasses Row-Level Security. Server-side only! Never expose to client-side.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Supabase Auth JWT Secret (Found in Settings -> API Keys -> JWT Settings)
# Used by FastAPI backend to verify incoming Bearer JWT tokens from logged-in users.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL hosted via Supabase)
# Found in Supabase Dashboard -> Settings -> Database -> Connection string -> URI
# - Transaction pooler (Port 6543): Recommended for application queries
# - Direct connection (Port 5432): Required for Alembic schema migrations
# Note: Supabase cloud requires SSL (?sslmode=require)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<your-project-ref>:<db_password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. FastAPI Backend Settings (Dikshant / Backend App)
# ------------------------------------------------------------------------------
APP_NAME=DOGFOOD-Backend
APP_ENV=development
DEBUG=True
API_V1_STR=/api
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS - Allowed origins for browser clients (Himanshu's Frontend)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 4. Vite Frontend Settings (Himanshu / Frontend App)
# Note: Vite automatically exposes variables prefixed with VITE_ to the browser client.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
# Use new Publishable Key (sb_publishable_...) or legacy anon key (eyJ...)
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_API_URL=http://localhost:8000/api
