# ==============================================================================
# DOGFOOD Hackathon Platform - Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit the actual .env file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration
# (Found in Supabase Dashboard -> Project Settings -> API / Database)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL hosted via Supabase)
# Direct connection (port 5432 - required for Alembic migrations)
# Or Transaction pooler (port 6543)
# Note: Supabase cloud requires SSL (?sslmode=require)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:<db_password>@db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. FastAPI Backend Settings (Dikshant / Backend App)
# ------------------------------------------------------------------------------
APP_NAME=DOGFOOD-Backend
APP_ENV=development
DEBUG=True
API_V1_STR=/api
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS - Allowed origins for browser clients (Himanshu's Frontend)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 4. Vite Frontend Settings (Himanshu / Frontend App)
# Note: Vite automatically exposes variables prefixed with VITE_ to the client
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_API_URL=http://localhost:8000/api
