# Force LF for everything a Linux container executes or parses.
# Without this, core.autocrlf=true (set in this repo) converts these to CRLF
# when Render checks out the repo, and /bin/sh cannot execute a CRLF script.
*.sh             text eol=lf
*.template       text eol=lf
Dockerfile       text eol=lf
*.dockerfile     text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf
*.conf           text eol=lf

# Windows-only convenience files keep native endings.
*.bat            text eol=crlf
*.ps1            text eol=crlf
